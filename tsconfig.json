{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@ctp/config": ["./packages/config/src/index.ts"],
      "@ctp/logger": ["./packages/logger/src/index.ts"],
      "@ctp/database": ["./packages/database/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "tests/**/*.ts", "vitest*.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
