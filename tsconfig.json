    "noEmit": true,
    "paths": {
      "@ctp/exchange-bybit": ["./packages/exchange-bybit/src/index.ts"],
      "@ctp/exchange-binance": ["./packages/exchange-binance/src/index.ts"],
      "@ctp/exchange-core": ["./packages/exchange-core/src/index.ts"],
      "@ctp/auth": ["./packages/auth/src/index.ts"],
      "@ctp/config": ["./packages/config/src/index.ts"],
