{
  "name": "@ctp/paper-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./evidence": {
      "types": "./dist/evidence.d.ts",
      "default": "./dist/evidence.js"
    },
    "./portfolio": {
      "types": "./dist/portfolio.d.ts",
      "default": "./dist/portfolio.js"
    },
    "./configuration": {
      "types": "./dist/configuration.d.ts",
      "default": "./dist/configuration.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./funding": {
      "types": "./dist/funding.d.ts",
      "default": "./dist/funding.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ctp/market-data": "workspace:*",
    "@ctp/portfolio": "workspace:*",
    "@ctp/exchange-core": "workspace:*",
    "decimal.js": "10.6.0",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
