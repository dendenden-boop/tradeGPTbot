model ReconciliationRun {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String              @db.Uuid
  accountId       String              @db.Uuid
  mode            TradingMode
  connectionId    String?             @db.Uuid
  market          MarketType
  epoch           BigInt
  state           ReconciliationState @default(REQUIRED)
  trigger         String              @db.VarChar(64)
  startCursor     String?             @db.VarChar(512)
  endCursor       String?             @db.VarChar(512)
  startedAt       DateTime            @db.Timestamptz(3)
  completedAt     DateTime?           @db.Timestamptz(3)
  unresolvedCount Int                 @default(0)
  evidenceHash    Bytes?
  failureCode     String?             @db.VarChar(64)
  version         Int                 @default(0)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  tenant          User                @relation("ReconciliationRun_tenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account         ExchangeAccount     @relation("ReconciliationRun_account", fields: [tenantId, accountId, mode], references: [tenantId, id, mode], onDelete: Restrict, onUpdate: Restrict)
  connection      ExchangeConnection? @relation("ReconciliationRun_connection", fields: [tenantId, connectionId, accountId, mode], references: [tenantId, id, accountId, mode], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, accountId, mode, market, epoch])
  @@index([tenantId, state, startedAt])
  @@map("reconciliation_run")
}
