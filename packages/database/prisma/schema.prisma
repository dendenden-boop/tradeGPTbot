model Candle {
  id               String                @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instrumentId     String                @db.Uuid
  ruleVersionId    String                @db.Uuid
  timeframeSeconds Int
  openTime         DateTime              @db.Timestamptz(3)
  closeTime        DateTime              @db.Timestamptz(3)
  /// @decimal price 38,18 positive
  open             Decimal               @db.Decimal
  /// @decimal price 38,18 positive
  high             Decimal               @db.Decimal
  /// @decimal price 38,18 positive
  low              Decimal               @db.Decimal
  /// @decimal price 38,18 positive
  close            Decimal               @db.Decimal
