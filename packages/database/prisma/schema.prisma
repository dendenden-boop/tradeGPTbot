model OutboxEvent {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String          @db.Uuid
  eventType        String          @db.VarChar(128)
  schemaVersion    Int
  aggregateType    String          @db.VarChar(64)
  aggregateId      String          @db.Uuid
  aggregateVersion BigInt
  /// Validated domain data or IDs only; credentials and tokens are forbidden.
  payload          Json
  occurredAt       DateTime        @db.Timestamptz(3)
  availableAt      DateTime        @default(now()) @db.Timestamptz(3)
  attempts         Int             @default(0)
  claimedBy        String?         @db.VarChar(128)
  claimExpiresAt   DateTime?       @db.Timestamptz(3)
  deliveredAt      DateTime?       @db.Timestamptz(3)
  lastErrorCode    String?         @db.VarChar(64)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  tenant           User            @relation("OutboxEvent_tenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  consumerReceipts ConsumerInbox[] @relation("ConsumerInbox_event")
  notifications    Notification[]  @relation("Notification_event")

  @@unique([tenantId, id])
  @@unique([tenantId, aggregateType, aggregateId, aggregateVersion, eventType], map: "outbox_aggregate_event")
  @@index([tenantId, deliveredAt, availableAt, id])
  @@map("outbox_event")
}

model ConsumerInbox {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String      @db.Uuid
  consumer      String      @db.VarChar(128)
  eventId       String      @db.Uuid
  eventType     String      @db.VarChar(128)
  schemaVersion Int
  payloadHash   Bytes
  processedAt   DateTime    @default(now()) @db.Timestamptz(3)
  retainUntil   DateTime    @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  tenant        User        @relation("ConsumerInbox_tenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  event         OutboxEvent @relation("ConsumerInbox_event", fields: [tenantId, eventId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([consumer, eventId])
  @@index([tenantId, processedAt])
  @@map("consumer_inbox")
}

model Notification {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String             @db.Uuid
  eventId          String?            @db.Uuid
  channel          String             @db.VarChar(32)
  templateKey      String             @db.VarChar(64)
  templateVersion  Int
  status           NotificationStatus @default(PENDING)
  /// Safe template parameters; no credentials, session tokens, or private payload capture.
  parameters       Json
  deduplicationKey String             @db.VarChar(256)
  attempts         Int                @default(0)
  nextAttemptAt    DateTime?          @db.Timestamptz(3)
  deliveredAt      DateTime?          @db.Timestamptz(3)
  readAt           DateTime?          @db.Timestamptz(3)
  lastErrorCode    String?            @db.VarChar(64)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  tenant           User               @relation("Notification_tenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  event            OutboxEvent?       @relation("Notification_event", fields: [tenantId, eventId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, channel, deduplicationKey])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("notification")
}

model AuditLog {
