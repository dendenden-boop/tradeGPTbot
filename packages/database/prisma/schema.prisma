  slippageModelVersion String             @db.VarChar(64)
  feeModelVersion      String             @db.VarChar(64)
  seed                 BigInt
  valuationAsset       String             @db.VarChar(32)
  /// @decimal aggregate 48,18 positive
  initialCapital       Decimal            @db.Decimal
  startAt              DateTime           @db.Timestamptz(3)
  endAt                DateTime           @db.Timestamptz(3)
  startedAt            DateTime?          @db.Timestamptz(3)
  completedAt          DateTime?          @db.Timestamptz(3)
  artifactUri          String?            @db.VarChar(2048)
  artifactHash         Bytes?
  failureCode          String?            @db.VarChar(64)
  version              Int                @default(0)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  tenant               User               @relation("Backtest_tenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  definition           StrategyDefinition @relation("Backtest_definition", fields: [definitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  datasetManifest      DatasetManifest    @relation("Backtest_datasetManifest", fields: [datasetManifestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  trades               BacktestTrade[]    @relation("BacktestTrade_backtest")
  metrics              BacktestMetric[]   @relation("BacktestMetric_backtest")

  @@unique([tenantId, id])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("backtest")
}

