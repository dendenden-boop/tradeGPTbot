// PHASE 2: PostgreSQL relational persistence. Additional CHECK/RLS/append-only
// constraints are installed by reviewed SQL migrations. No trading execution is implemented.
// Money uses unconstrained NUMERIC; SQL rejects unsupported precision instead of rounding.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum TradingMode {
  PAPER
  TESTNET
  DEMO
  LIVE
}

enum Exchange {
  BINANCE
  BYBIT
  OKX
  HTX
}

enum MarketType {
  SPOT
  MARGIN
  PERPETUAL
  FUTURES
  OPTION
}

enum AccountStatus {
  PENDING
  ACTIVE
  PAUSED
  RECONCILIATION_REQUIRED
  DISABLED
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETION_REQUESTED
  PSEUDONYMIZED
}

enum CredentialStatus {
  PENDING
  ACTIVE
  REVOKED
  SUPERSEDED
}

enum OrderSide {
  BUY
  SELL
}

enum PositionSide {
  NET
  LONG
  SHORT
}

enum OrderType {
  MARKET
  LIMIT
  STOP_MARKET
  STOP_LIMIT
  TAKE_PROFIT_MARKET
  TAKE_PROFIT_LIMIT
  TRAILING_STOP
}

enum TimeInForce {
  GTC
  IOC
  FOK
  POST_ONLY
}

enum OrderStatus {
  CREATED
  RISK_APPROVED
  SUBMITTING
  SUBMITTED
  PARTIALLY_FILLED
  FILLED
  CANCEL_PENDING
  CANCELED
  REJECTED
  EXPIRED
  UNKNOWN
  RECONCILIATION_REQUIRED
}

enum ReconciliationState {
  REQUIRED
  IN_PROGRESS
  CONSISTENT
  UNRESOLVED
}

enum IntentOrigin {
  USER
  STRATEGY
  EXTERNAL
  RISK_REDUCTION
}

enum Destination {
  PAPER_ENGINE
  EXCHANGE
}

enum SubmissionOperation {
  PLACE
  CANCEL
  AMEND
}

enum SubmissionStatus {
  DISPATCHING
  ACKNOWLEDGED
  REJECTED
  UNKNOWN
  RECONCILED
}

enum StrategyStatus {
  DRAFT
  STOPPED
  STARTING
  RUNNING
  PAUSED
  FAILED
  ARCHIVED
}

enum RunStatus {
  PENDING
  RUNNING
  PAUSED
  SUCCEEDED
  FAILED
  CANCELED
}

enum RiskVerdict {
  APPROVE
  REJECT
  REDUCE_ONLY
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
  UNRESOLVED
}

enum RiskScope {
  USER
  ACCOUNT
  STRATEGY
  INSTRUMENT
}

enum LedgerCause {
  FILL
  FEE
  FUNDING
  DEPOSIT
  WITHDRAWAL_OBSERVED
  TRANSFER
  PAPER_SEED
  ADJUSTMENT
}

enum LedgerBucket {
  AVAILABLE
  RESERVED
  POSITION
  FEE
  FUNDING
  EXTERNAL
  EQUITY
}

enum LiquidityRole {
  MAKER
  TAKER
  UNKNOWN
}

enum FeeKind {
  CHARGE
  REBATE
}

enum DataQuality {
  VERIFIED
  PROVISIONAL
  GAP
  INVALID
}

enum NotificationStatus {
  PENDING
  DELIVERED
  FAILED
  READ
}

enum Severity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum CircuitStatus {
  CLOSED
  OPEN
  HALF_OPEN
}

model User {
  id                            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emailNormalized               String?                  @unique @db.VarChar(320)
  passwordHash                  String?                  @db.VarChar(512)
  status                        UserStatus               @default(PENDING_VERIFICATION)
  emailVerifiedAt               DateTime?                @db.Timestamptz(3)
  passwordChangedAt             DateTime?                @db.Timestamptz(3)
  sessionEpoch                  Int                      @default(0)
  deletionRequestedAt           DateTime?                @db.Timestamptz(3)
  pseudonymizedAt               DateTime?                @db.Timestamptz(3)
  updatedAt                     DateTime                 @updatedAt @db.Timestamptz(3)
  createdAt                     DateTime                 @default(now()) @db.Timestamptz(3)
  userSessionRecords            UserSession[]            @relation("UserSession_tenant")
  emailVerificationTokenRecords EmailVerificationToken[] @relation("EmailVerificationToken_tenant")
  passwordResetTokenRecords     PasswordResetToken[]     @relation("PasswordResetToken_tenant")
  twoFactorConfigRecords        TwoFactorConfig?         @relation("TwoFactorConfig_tenant")
  recoveryCodeRecords           RecoveryCode[]           @relation("RecoveryCode_tenant")
  exchangeAccountRecords        ExchangeAccount[]        @relation("ExchangeAccount_tenant")
  exchangeConnectionRecords     ExchangeConnection[]     @relation("ExchangeConnection_tenant")
  encryptedCredentialRecords    EncryptedCredential[]    @relation("EncryptedCredential_tenant")
  liveGrantRecords              LiveGrant[]              @relation("LiveGrant_tenant")
  balanceSnapshotRecords        BalanceSnapshot[]        @relation("BalanceSnapshot_tenant")
  positionRecords               Position[]               @relation("Position_tenant")
  accountStateVersionRecords    AccountStateVersion[]    @relation("AccountStateVersion_tenant")
  ledgerTransactionRecords      LedgerTransaction[]      @relation("LedgerTransaction_tenant")
  ledgerEntryRecords            LedgerEntry[]            @relation("LedgerEntry_tenant")
  assetValuationRecords         AssetValuation[]         @relation("AssetValuation_tenant")
  orderIntentRecords            OrderIntent[]            @relation("OrderIntent_tenant")
  idempotencyRecordRecords      IdempotencyRecord[]      @relation("IdempotencyRecord_tenant")
  orderRecords                  Order[]                  @relation("Order_tenant")
  algoOrderRecords              AlgoOrder[]              @relation("AlgoOrder_tenant")
  submissionAttemptRecords      SubmissionAttempt[]      @relation("SubmissionAttempt_tenant")
  orderEventRecords             OrderEvent[]             @relation("OrderEvent_tenant")
  tradeRecords                  Trade[]                  @relation("Trade_tenant")
  fillRecords                   Fill[]                   @relation("Fill_tenant")
  feeRecords                    Fee[]                    @relation("Fee_tenant")
  fundingPaymentRecords         FundingPayment[]         @relation("FundingPayment_tenant")
  strategyInstanceRecords       StrategyInstance[]       @relation("StrategyInstance_tenant")
  strategyRunRecords            StrategyRun[]            @relation("StrategyRun_tenant")
  strategyStateRecords          StrategyState[]          @relation("StrategyState_tenant")
  signalRecords                 Signal[]                 @relation("Signal_tenant")
  riskProfileRecords            RiskProfile[]            @relation("RiskProfile_tenant")
  riskDecisionRecords           RiskDecision[]           @relation("RiskDecision_tenant")
  riskEventRecords              RiskEvent[]              @relation("RiskEvent_tenant")
  riskReservationRecords        RiskReservation[]        @relation("RiskReservation_tenant")
  riskBudgetRecords             RiskBudget[]             @relation("RiskBudget_tenant")
  tradingPauseRecords           TradingPause[]           @relation("TradingPause_tenant")
  circuitStateRecords           CircuitState[]           @relation("CircuitState_tenant")
  paperAccountRecords           PaperAccount[]           @relation("PaperAccount_tenant")
  paperOrderRecords             PaperOrder[]             @relation("PaperOrder_tenant")
  paperPositionRecords          PaperPosition[]          @relation("PaperPosition_tenant")
  backtestRecords               Backtest[]               @relation("Backtest_tenant")
  backtestTradeRecords          BacktestTrade[]          @relation("BacktestTrade_tenant")
  backtestMetricRecords         BacktestMetric[]         @relation("BacktestMetric_tenant")
  outboxEventRecords            OutboxEvent[]            @relation("OutboxEvent_tenant")
  consumerInboxRecords          ConsumerInbox[]          @relation("ConsumerInbox_tenant")
  notificationRecords           Notification[]           @relation("Notification_tenant")
  auditLogRecords               AuditLog[]               @relation("AuditLog_tenant")
  reconciliationRunRecords      ReconciliationRun[]      @relation("ReconciliationRun_tenant")

  @@map("user")
}

model UserSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @db.Uuid
  tokenHash     Bytes     @unique
  expiresAt     DateTime  @db.Timestamptz(3)
  idleExpiresAt DateTime  @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  stepUpAt      DateTime? @db.Timestamptz(3)
  sessionEpoch  Int
  userAgentHash Bytes?
  ipPrefixHash  Bytes?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  tenant        User      @relation("UserSession_tenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, revokedAt, expiresAt])
  @@map("user_session")
}

model EmailVerificationToken {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @db.Uuid
  tokenHash       Bytes     @unique
  emailNormalized String    @db.VarChar(320)
  expiresAt       DateTime  @db.Timestamptz(3)
  consumedAt      DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  tenant          User      @relation("EmailVerificationToken_tenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, expiresAt])
  @@map("email_verification_token")
}

model PasswordResetToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @db.Uuid
  tokenHash    Bytes     @unique
  expiresAt    DateTime  @db.Timestamptz(3)
  consumedAt   DateTime? @db.Timestamptz(3)
  sessionEpoch Int
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  tenant       User      @relation("PasswordResetToken_tenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, expiresAt])
  @@map("password_reset_token")
}

model TwoFactorConfig {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String         @db.Uuid
  ciphertext        Bytes
  nonce             Bytes
  tag               Bytes
  wrappedDek        Bytes
  kmsKeyId          String         @db.VarChar(512)
  kmsKeyVersion     String         @db.VarChar(256)
  encryptionVersion Int
  aadVersion        Int
  lastAcceptedStep  BigInt?
  enabledAt         DateTime?      @db.Timestamptz(3)
  revokedAt         DateTime?      @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  tenant            User           @relation("TwoFactorConfig_tenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recoveryCodes     RecoveryCode[] @relation("RecoveryCode_twoFactorConfig")

  @@unique([tenantId, id])
  @@unique([tenantId])
  @@map("two_factor_config")
}

model RecoveryCode {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String          @db.Uuid
  twoFactorConfigId String          @db.Uuid
  codeHash          Bytes           @unique
  consumedAt        DateTime?       @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  tenant            User            @relation("RecoveryCode_tenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  twoFactorConfig   TwoFactorConfig @relation("RecoveryCode_twoFactorConfig", fields: [tenantId, twoFactorConfigId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, twoFactorConfigId])
  @@map("recovery_code")
}

model ExchangeAccount {
  id                         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                   String                @db.Uuid
  exchange                   Exchange
  mode                       TradingMode           @default(PAPER)
  /// Stable exchange account UID or generated paper namespace; never a credential.
  externalAccountId          String                @db.VarChar(128)
  region                     String                @db.VarChar(32)
  accountMode                String                @db.VarChar(32)
  status                     AccountStatus         @default(PENDING)
  reconciliationEpoch        BigInt                @default(0)
  permissionEpoch            BigInt                @default(0)
  clientIdEpoch              String                @db.VarChar(64)
  clientIdHighWatermark      BigInt                @default(0)
  version                    Int                   @default(0)
  reconciledAt               DateTime?             @db.Timestamptz(3)
  updatedAt                  DateTime              @updatedAt @db.Timestamptz(3)
  createdAt                  DateTime              @default(now()) @db.Timestamptz(3)
  tenant                     User                  @relation("ExchangeAccount_tenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  exchangeConnectionRecords  ExchangeConnection[]  @relation("ExchangeConnection_account")
  balanceSnapshotRecords     BalanceSnapshot[]     @relation("BalanceSnapshot_account")
  positionRecords            Position[]            @relation("Position_account")
  accountStateVersionRecords AccountStateVersion[] @relation("AccountStateVersion_account")
  ledgerTransactionRecords   LedgerTransaction[]   @relation("LedgerTransaction_account")
  ledgerEntryRecords         LedgerEntry[]         @relation("LedgerEntry_account")
  assetValuationRecords      AssetValuation[]      @relation("AssetValuation_account")
  orderIntentRecords         OrderIntent[]         @relation("OrderIntent_account")
  orderRecords               Order[]               @relation("Order_account")
  algoOrderRecords           AlgoOrder[]           @relation("AlgoOrder_account")
  tradeRecords               Trade[]               @relation("Trade_account")
  fillRecords                Fill[]                @relation("Fill_account")
  fundingPaymentRecords      FundingPayment[]      @relation("FundingPayment_account")
  strategyInstanceRecords    StrategyInstance[]    @relation("StrategyInstance_account")
  strategyRunRecords         StrategyRun[]         @relation("StrategyRun_account")
  riskDecisionRecords        RiskDecision[]        @relation("RiskDecision_account")
  riskReservationRecords     RiskReservation[]     @relation("RiskReservation_account")
  riskBudgetRecords          RiskBudget[]          @relation("RiskBudget_account")
  paperAccountRecords        PaperAccount?         @relation("PaperAccount_account")
  reconciliationRunRecords   ReconciliationRun[]   @relation("ReconciliationRun_account")
  riskEventRecords           RiskEvent[]           @relation("RiskEvent_account")
  tradingPauseRecords        TradingPause[]        @relation("TradingPause_account")
  circuitStateRecords        CircuitState[]        @relation("CircuitState_account")

  @@unique([tenantId, id])
  @@unique([tenantId, id, mode])
  @@unique([tenantId, exchange, mode, region, externalAccountId])
  @@index([tenantId, status])
  @@map("exchange_account")
}

model ExchangeConnection {
  id                           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                     String                @db.Uuid
  accountId                    String                @db.Uuid
  mode                         TradingMode
  label                        String                @db.VarChar(100)
  status                       AccountStatus         @default(PENDING)
  permissionsVersion           Int                   @default(0)
  permissionsVerifiedAt        DateTime?             @db.Timestamptz(3)
  /// Allowlisted permission flags only; no credentials or exchange response body.
  permissions                  Json
  withdrawalPermissionDetected Boolean               @default(false)
  version                      Int                   @default(0)
  disabledAt                   DateTime?             @db.Timestamptz(3)
  updatedAt                    DateTime              @updatedAt @db.Timestamptz(3)
  createdAt                    DateTime              @default(now()) @db.Timestamptz(3)
  tenant                       User                  @relation("ExchangeConnection_tenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account                      ExchangeAccount       @relation("ExchangeConnection_account", fields: [tenantId, accountId, mode], references: [tenantId, id, mode], onDelete: Restrict, onUpdate: Restrict)
  credentials                  EncryptedCredential[] @relation("EncryptedCredential_connection")
  liveGrants                   LiveGrant[]           @relation("LiveGrant_connection")
  orderIntentRecords           OrderIntent[]         @relation("OrderIntent_connection")
  orderRecords                 Order[]               @relation("Order_connection")
  reconciliationRunRecords     ReconciliationRun[]   @relation("ReconciliationRun_connection")

  @@unique([tenantId, id])
  @@unique([tenantId, id, mode])
  @@unique([tenantId, id, accountId, mode], map: "connection_account_scope")
  @@index([tenantId, accountId, status])
  @@map("exchange_connection")
}

model EncryptedCredential {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String             @db.Uuid
  connectionId      String             @db.Uuid
  version           Int
  status            CredentialStatus   @default(PENDING)
  ciphertext        Bytes
  nonce             Bytes
  tag               Bytes
  wrappedDek        Bytes
  kmsKeyId          String             @db.VarChar(512)
  kmsKeyVersion     String             @db.VarChar(256)
  encryptionVersion Int
  aadVersion        Int
  activatedAt       DateTime?          @db.Timestamptz(3)
  revokedAt         DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  tenant            User               @relation("EncryptedCredential_tenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  connection        ExchangeConnection @relation("EncryptedCredential_connection", fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  liveGrants        LiveGrant[]        @relation("LiveGrant_credential")

  @@unique([tenantId, id])
  @@unique([tenantId, connectionId, version])
  @@unique([tenantId, id, connectionId, version], map: "credential_connection_version")
  @@map("encrypted_credential")
}

model LiveGrant {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String              @db.Uuid
  connectionId       String              @db.Uuid
  credentialId       String              @db.Uuid
  riskProfileId      String              @db.Uuid
  mode               TradingMode         @default(LIVE)
  credentialVersion  Int
  permissionsVersion Int
  riskPolicyVersion  Int
  permissionEpoch    BigInt
  stepUpAt           DateTime            @db.Timestamptz(3)
  expiresAt          DateTime            @db.Timestamptz(3)
  revokedAt          DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  tenant             User                @relation("LiveGrant_tenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  connection         ExchangeConnection  @relation("LiveGrant_connection", fields: [tenantId, connectionId, mode], references: [tenantId, id, mode], onDelete: Restrict, onUpdate: Restrict)
  credential         EncryptedCredential @relation("LiveGrant_credential", fields: [tenantId, credentialId, connectionId, credentialVersion], references: [tenantId, id, connectionId, version], onDelete: Restrict, onUpdate: Restrict)
  riskProfile        RiskProfile         @relation("LiveGrant_riskProfile", fields: [tenantId, riskProfileId, riskPolicyVersion], references: [tenantId, id, version], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, connectionId, expiresAt])
  @@map("live_grant")
}

model Instrument {
  id                            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exchange                      Exchange
  market                        MarketType
  mode                          TradingMode
  exchangeSymbol                String                   @db.VarChar(128)
  baseAsset                     String                   @db.VarChar(32)
  quoteAsset                    String                   @db.VarChar(32)
  settlementAsset               String?                  @db.VarChar(32)
  expiryAt                      DateTime?                @db.Timestamptz(3)
  isInverse                     Boolean                  @default(false)
  active                        Boolean                  @default(false)
  updatedAt                     DateTime                 @updatedAt @db.Timestamptz(3)
  createdAt                     DateTime                 @default(now()) @db.Timestamptz(3)
  ruleVersions                  InstrumentRuleVersion[]  @relation("InstrumentRuleVersion_instrument")
  positionRecords               Position[]               @relation("Position_instrument")
  assetValuationRecords         AssetValuation[]         @relation("AssetValuation_instrument")
  orderIntentRecords            OrderIntent[]            @relation("OrderIntent_instrument")
  orderRecords                  Order[]                  @relation("Order_instrument")
  algoOrderRecords              AlgoOrder[]              @relation("AlgoOrder_instrument")
  tradeRecords                  Trade[]                  @relation("Trade_instrument")
  fillRecords                   Fill[]                   @relation("Fill_instrument")
  fundingPaymentRecords         FundingPayment[]         @relation("FundingPayment_instrument")
  signalRecords                 Signal[]                 @relation("Signal_instrument")
  tradingPauseRecords           TradingPause[]           @relation("TradingPause_instrument")
  backtestTradeRecords          BacktestTrade[]          @relation("BacktestTrade_instrument")
  candleRecords                 Candle[]                 @relation("Candle_instrument")
  marketGapRecords              MarketGap[]              @relation("MarketGap_instrument")
  marketCheckpointRecords       MarketCheckpoint[]       @relation("MarketCheckpoint_instrument")
  subscriptionAssignmentRecords SubscriptionAssignment[] @relation("SubscriptionAssignment_instrument")

  @@unique([exchange, market, mode, exchangeSymbol])
  @@unique([id, market])
  @@map("instrument")
}

model InstrumentRuleVersion {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instrumentId         String          @db.Uuid
  version              Int
  isCurrent            Boolean         @default(false)
  effectiveAt          DateTime        @db.Timestamptz(3)
  fetchedAt            DateTime        @db.Timestamptz(3)
  sourceHash           Bytes
  /// @decimal price 38,18 positive
  priceTick            Decimal         @db.Decimal
  /// @decimal quantity 38,18 positive
  quantityStep         Decimal         @db.Decimal
  /// @decimal quantity 38,18 nonnegative
  minQuantity          Decimal         @db.Decimal
  /// @decimal quantity 38,18 positive
  maxQuantity          Decimal?        @db.Decimal
  /// @decimal amount 38,18 nonnegative
  minNotional          Decimal?        @db.Decimal
  /// @decimal quantity 38,18 positive
  contractSize         Decimal?        @db.Decimal
  contractUnit         String?         @db.VarChar(32)
  /// Allowlisted versioned rule metadata, never raw private exchange payloads.
  rules                Json
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  instrument           Instrument      @relation("InstrumentRuleVersion_instrument", fields: [instrumentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  positionRecords      Position[]      @relation("Position_ruleVersion")
  orderIntentRecords   OrderIntent[]   @relation("OrderIntent_ruleVersion")
  orderRecords         Order[]         @relation("Order_ruleVersion")
  fillRecords          Fill[]          @relation("Fill_ruleVersion")
  signalRecords        Signal[]        @relation("Signal_ruleVersion")
  backtestTradeRecords BacktestTrade[] @relation("BacktestTrade_ruleVersion")
  candleRecords        Candle[]        @relation("Candle_ruleVersion")
  riskDecisions        RiskDecision[]  @relation("RiskDecision_ruleVersion")

  @@unique([instrumentId, version])
  @@unique([id, instrumentId])
  @@unique([id, instrumentId, version], map: "instrument_rule_version_scope")
  @@index([instrumentId, effectiveAt])
  @@map("instrument_rule_version")
}

model CapabilitySnapshot {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exchange       Exchange
  market         MarketType
  mode           TradingMode
  region         String         @db.VarChar(32)
  accountMode    String         @db.VarChar(32)
  version        Int
  profileVersion String         @db.VarChar(64)
  verifiedAt     DateTime       @db.Timestamptz(3)
  expiresAt      DateTime       @db.Timestamptz(3)
  capabilities   Json
  evidenceHash   Bytes
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  riskDecisions  RiskDecision[] @relation("RiskDecision_capabilitySnapshot")

  @@unique([exchange, market, mode, region, accountMode, version])
  @@map("capability_snapshot")
}

model BalanceSnapshot {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String              @db.Uuid
  accountId      String              @db.Uuid
  mode           TradingMode
  stateVersionId String              @db.Uuid
  asset          String              @db.VarChar(32)
  /// @decimal aggregate 48,18 signed
  total          Decimal             @db.Decimal
  /// @decimal aggregate 48,18 signed
  available      Decimal             @db.Decimal
  /// @decimal aggregate 48,18 nonnegative
  reserved       Decimal             @db.Decimal
  /// @decimal aggregate 48,18 nonnegative
  borrowed       Decimal             @default(0) @db.Decimal
  sourceAt       DateTime            @db.Timestamptz(3)
  receivedAt     DateTime            @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  tenant         User                @relation("BalanceSnapshot_tenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account        ExchangeAccount     @relation("BalanceSnapshot_account", fields: [tenantId, accountId, mode], references: [tenantId, id, mode], onDelete: Restrict, onUpdate: Restrict)
  stateVersion   AccountStateVersion @relation("BalanceSnapshot_stateVersion", fields: [tenantId, stateVersionId, accountId, mode], references: [tenantId, id, accountId, mode], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, accountId, mode, stateVersionId, asset])
  @@index([tenantId, accountId, sourceAt(sort: Desc)])
  @@map("balance_snapshot")
}

model Position {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                @db.Uuid
  accountId         String                @db.Uuid
  mode              TradingMode
  instrumentId      String                @db.Uuid
  ruleVersionId     String                @db.Uuid
  positionSide      PositionSide
  positionBucket    String                @db.VarChar(64)
  asset             String                @db.VarChar(32)
  /// @decimal quantity 38,18 signed
  quantity          Decimal               @default(0) @db.Decimal
  /// @decimal price 38,18 nonnegative
