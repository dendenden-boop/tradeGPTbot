{
  "name": "@ctp/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate --config prisma.config.ts --no-hints",
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "migrate": "prisma migrate deploy --config prisma.config.ts",
    "validate": "prisma validate --config prisma.config.ts"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "prisma": "7.10.0"
  }
}
